{
    "name": "aerial",
    "version": "1.3.16",
    "videoJSONVersion": "1.15.0",
    "description": "Apple TV screen saver for Windows",
    "main": "app.js",
    "scripts": {
        "start": "npm run build:app && electron .",
        "build:runtime": "tsc -p tsconfig.runtime.json",
        "build:ui": "vite build",
        "build:app": "npm run build:runtime && npm run build:ui",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run build:runtime && node --test tests/widget-architecture.test.js",
        "dist": "electron-builder",
        "build:media-helper": "dotnet publish native/AerialMediaHelper/AerialMediaHelper.csproj -c Release -r win-x64 --self-contained true /p:PublishSingleFile=true /p:PublishReadyToRun=false -o build/media-helper",
        "build": "npm run build:app && npm run build:media-helper && electron-builder build && node scripts/create-scr-artifact.js",
        "lint": "npm run typecheck && node scripts/run-syntax-lint.js",
        "lint:targets": "node scripts/run-syntax-lint.js --list"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/phantasma2983/Aerial.git"
    },
    "author": "phantasma2983 (fork of OrangeJedi/Aerial)",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/phantasma2983/Aerial/issues"
    },
    "homepage": "https://github.com/phantasma2983/Aerial#readme",
    "devDependencies": {
        "@preact/preset-vite": "^2.10.6",
        "electron": "^40.6.1",
        "electron-builder": "^26.8.1",
        "typescript": "^7.0.2",
        "vite": "^6.4.3"
    },
    "dependencies": {
        "auto-launch": "~5.0.6",
        "electron-store": "~11.0.2",
        "electron-updater": "^6.8.3",
        "font-list-universal": "~1.0.0",
        "gridstack": "^13.2.0",
        "json-beautify": "~1.1.1",
        "preact": "^10.29.8",
        "suncalc": "~1.9.0",
        "zod": "^4.5.2"
    },
    "build": {
        "appId": "com.phantasma2983.aerial",
        "win": {
            "target": [
                "nsis",
                "portable"
            ]
        },
        "nsis": {
            "artifactName": "Aerial.Setup.${version}.${ext}",
            "installerIcon": "icon.ico",
            "guid": "17c6ea6b-270a-5297-8e23-9bcda4a29a48",
            "perMachine": false
        },
        "portable": {
            "artifactName": "aerial.exe",
            "useZip": true
        },
        "files": [
            "!assets/images/**"
        ],
        "extraResources": [
            {
                "from": "build/media-helper/aerial-media-helper.exe",
                "to": "media-helper/aerial-media-helper.exe"
            }
        ],
        "publish": [
            {
                "provider": "github",
                "owner": "phantasma2983",
                "repo": "Aerial"
            }
        ],
        "icon": "icon.ico",
        "productName": "Aerial"
    },
    "overrides": {
        "semver": "7.7.4"
    }
}
